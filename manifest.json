{
  "manifest_version": 3,
  "name": "myNewTab",
  "description": "本地新标签页：仅显示搜索框、快捷访问和自定义背景，使用浏览器网站图标。",
  "version": "1.0.3",
  "permissions": ["favicon"],
  "host_permissions": ["https://suggestqueries.google.com/*", "https://api.bing.com/*", "https://suggestion.baidu.com/*"],
  "chrome_url_overrides": { "newtab": "newtab.html" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
